# 이 파일은 템플릿일 뿐, 애플리케이션이 자동으로 읽지 않는다.
#
# AnthropicOkHttpClient.fromEnv() 는 운영체제 환경변수를 읽는다.
# Spring Boot 도 .env 를 로드하지 않는다(dotenv 로더를 넣지 않았다).
# 아래 값을 셸에 export 해야 한다.
#
#   PowerShell   $env:ANTHROPIC_API_KEY="sk-ant-..."
#   bash         export ANTHROPIC_API_KEY=sk-ant-...
#
# 키 없이 돌리려면:  ./gradlew bootRun --args='--spring.profiles.active=stub'

ANTHROPIC_API_KEY=sk-ant-...

# 모델은 설정값이다. AI Eval 로 측정한 뒤 내릴지 정한다.
# EVIDENCE_MODEL=claude-haiku-4-5
